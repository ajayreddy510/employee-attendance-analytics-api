# MongoDB Connection Settings
# Primary environment variables expected by the assignment contract:
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB=attendance_db

# Alternative alias names (also supported by the application):
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DATABASE_NAME=attendance_db
